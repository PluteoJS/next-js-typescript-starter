{
	"name": "pluteojs-nextjs-starter",
	"version": "0.0.0",
	"private": true,
	"packageManager": "yarn@4.7.0",
	"template": {
		"name": "PluteoJS Next.js Starter",
		"version": "1.0.0",
		"repository": "https://github.com/PluteoJS/next-js-typescript-starter"
	},
	"scripts": {
		"prepare": "husky",
		"check-types": "tsc --noemit",
		"run-eslint": "eslint . --ext .js,.jsx,.ts,.tsx",
		"next-lint": "next lint . --ext .js,.jsx,.ts,.tsx",
		"lint": "yarn run-eslint && yarn check-types",
		"format": "prettier --check \"src/**/*.ts\"",
		"start:dev": "next dev --turbopack",
		"build": "next build",
		"start:production": "next start"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": [
			"prettier --check",
			"eslint"
		]
	},
	"standard-version": {
		"skip": {
			"tag": true
		},
		"scripts": {
			"postcommit": "ts-node -P tsconfig.scripts.json ./.standard-version/commands/FixGitFlowReleaseBranchName.ts"
		}
	},
	"dependencies": {
		"@radix-ui/react-slot": "^1.2.4",
		"@reduxjs/toolkit": "^2.11.2",
		"axios": "^1.13.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^0.563.0",
		"next": "16.1.6",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"react-redux": "^9.2.0",
		"redux-logger": "^3.0.6",
		"tailwind-merge": "^3.4.0",
		"tw-animate-css": "^1.2.5",
		"uuid": "^13.0.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^19.8.0",
		"@commitlint/config-conventional": "^19.8.0",
		"@eslint/compat": "^1.2.8",
		"@eslint/eslintrc": "^3",
		"@tailwindcss/postcss": "^4",
		"@types/conventional-recommended-bump": "6.1.1",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@types/redux-logger": "^3",
		"@types/semver": "^7.7.0",
		"conventional-recommended-bump": "6.1.0",
		"eslint": "^9",
		"eslint-config-next": "16.1.6",
		"eslint-import-resolver-typescript": "^4.4.4",
		"eslint-plugin-import": "^2.31.0",
		"eslint-plugin-next": "^0.0.0",
		"eslint-plugin-prettier": "^5.2.6",
		"husky": "^9.1.7",
		"lint-staged": "^15.5.1",
		"prettier": "^3.5.3",
		"semver": "^7.7.1",
		"simple-git": "^3.27.0",
		"standard-version": "^9.5.0",
		"tailwindcss": "^4",
		"ts-node": "^10.9.2",
		"typescript": "^5"
	},
	"volta": {
		"node": "22.14.0",
		"yarn": "4.7.0"
	}
}
